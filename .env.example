# Dune Analytics API Key (for memecoin-radar-mcp)
DUNE_API_KEY=your_dune_api_key_here

# Bags.fm API Configuration
BAGS_API_KEY=your_bags_api_key_here
BAGS_API_URL=https://api.bags.fm

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WALLET_PRIVATE_KEY=your_wallet_private_key_here

# Trading Configuration
MAX_POSITION_SIZE_SOL=1.0
MAX_TOTAL_PORTFOLIO_SOL=10.0
MIN_LIQUIDITY_USD=50000
SLIPPAGE_BPS=100
STOP_LOSS_PERCENTAGE=20
TAKE_PROFIT_PERCENTAGE=50

# Agent Configuration
CHECK_INTERVAL_SECONDS=60
KOL_BUY_MIN_AMOUNT_SOL=0.1
TRENDING_TOKEN_MIN_VOLUME_24H=100000
SIGNAL_SCORE_THRESHOLD=7

# API Server Integration (for frontend)
API_SERVER_URL=http://localhost:3001
BOT_API_KEY=your_secret_bot_api_key_here

# Bagsy Token Configuration
BAGSY_TOKEN_MINT=your_bagsy_token_mint_address_here
FEE_CLAIM_INTERVAL_HOURS=1
MIN_CLAIM_AMOUNT_SOL=0.01

# Logging
LOG_LEVEL=info
