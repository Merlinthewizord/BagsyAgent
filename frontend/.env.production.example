# Production Environment Variables for Vercel
# These must be set in Vercel Dashboard → Settings → Environment Variables

# Backend API URL (Replace with your actual Render backend URL)
NEXT_PUBLIC_API_URL=https://bagsy-backend.onrender.com

# Example: After deploying backend to Render, you'll get a URL like:
# https://bagsy-backend-xxxx.onrender.com
# Use that URL here (without trailing slash)
